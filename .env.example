# PostgreSQL login used by local Docker Compose.
POSTGRES_USER=app
# PostgreSQL password used by local Docker Compose; replace outside local use.
POSTGRES_PASSWORD=app_secret
# PostgreSQL database used by local Docker Compose.
POSTGRES_DB=app
# Browser-visible backend URL.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Server-side frontend-to-backend URL.
API_ORIGIN=http://backend:8080
